# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# Large raw data downloads (real ERA5/Sentinel/GBIF). Synthetic data is regenerated by code.
data/raw/
*.nc
*.grib
*.tif
*.tiff
*.zip

# Large model checkpoints. Small demo checkpoints (<5MB) may be force-added if needed for results.
*.ckpt
checkpoints/*.pt
!**/results/**/*.pt

# Secrets
.env
*.key

# OS
.DS_Store
Thumbs.db

# Keep committed RESULTS artifacts (plots, metrics, logs) — they are the deliverable.
!**/results/**
!**/*.png
!**/*.json
!**/*.jsonl
!**/*.csv
